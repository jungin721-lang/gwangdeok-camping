import os, json, sqlite3, secrets
from http.server import ThreadingHTTPServer, BaseHTTPRequestHandler
from urllib.parse import urlparse

DB='camping.db'
PASSWORD=os.environ.get('OPERATOR_PASSWORD','change-me-now')
SESSIONS=set()

def connect():
    c=sqlite3.connect(DB); c.row_factory=sqlite3.Row; return c

def init_db():
    c=connect(); c.execute('''CREATE TABLE IF NOT EXISTS reservations(
      id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT, phone TEXT, type TEXT,
      start_date TEXT, days INTEGER, extra_people INTEGER, extra_cars INTEGER,
      option_name TEXT, amount INTEGER, payment_status TEXT DEFAULT '미결제',
      status TEXT DEFAULT '예약 신청', memo TEXT)'''); c.commit(); c.close()

def amount(t, days, people, cars, option):
    base=180000 if t=='long' else 150000*days if t=='glamp' else 30000*days
    extra=people*10000*days + cars*5000*days
    if option=='electric': extra += 5000*days
    if option=='bbq': extra += 20000
    return base+extra

def send(h, data, code=200, cookie=None):
    b=json.dumps(data,ensure_ascii=False).encode(); h.send_response(code)
    h.send_header('Content-Type','application/json; charset=utf-8')
    if cookie: h.send_header('Set-Cookie',cookie)
    h.send_header('Content-Length',str(len(b))); h.end_headers(); h.wfile.write(b)

class Handler(BaseHTTPRequestHandler):
    def log_message(self,*args): pass
    def read_json(self):
        n=int(self.headers.get('Content-Length','0')); return json.loads(self.rfile.read(n) or b'{}')
    def operator(self):
        token=self.headers.get('Cookie','').replace('session=','').split(';')[0]
        return token in SESSIONS
    def do_GET(self):
        path=urlparse(self.path).path
        if path=='/':
            b=open('index.html','rb').read(); self.send_response(200); self.send_header('Content-Type','text/html; charset=utf-8'); self.send_header('Content-Length',str(len(b))); self.end_headers(); self.wfile.write(b); return
        if path=='/api/session': return send(self,{'operator':self.operator()})
        if path=='/api/reservations':
            if not self.operator(): return send(self,{'error':'운영자 로그인이 필요합니다.'},401)
            c=connect(); rows=[dict(x) for x in c.execute('SELECT * FROM reservations ORDER BY id DESC')]; c.close(); return send(self,rows)
        return send(self,{'error':'Not found'},404)
    def do_POST(self):
        path=urlparse(self.path).path; d=self.read_json()
        if path=='/api/login':
            if d.get('password')!=PASSWORD: return send(self,{'error':'비밀번호가 올바르지 않습니다.'},403)
            token=secrets.token_urlsafe(24); SESSIONS.add(token); return send(self,{'ok':True},cookie=f'session={token}; HttpOnly; SameSite=Strict; Path=/')
        if path=='/api/reservations':
            try:
                t=d['type']; days=max(1,int(d.get('days',1))); people=max(0,int(d.get('extra_people',0))); cars=max(0,int(d.get('extra_cars',0))); option=d.get('option_name','none')
                c=connect(); cur=c.execute('INSERT INTO reservations(name,phone,type,start_date,days,extra_people,extra_cars,option_name,amount,memo) VALUES(?,?,?,?,?,?,?,?,?,?)',(d['name'],d['phone'],t,d['start_date'],days,people,cars,option,amount(t,days,people,cars,option),d.get('memo',''))); c.commit(); rid=cur.lastrowid; c.close(); return send(self,{'ok':True,'id':rid,'amount':amount(t,days,people,cars,option)},201)
            except Exception: return send(self,{'error':'입력값을 확인해 주세요.'},400)
        if path.startswith('/api/reservations/'):
            if not self.operator(): return send(self,{'error':'권한이 없습니다.'},401)
            rid=path.rsplit('/',1)[1]; c=connect(); c.execute('UPDATE reservations SET payment_status=?, status=? WHERE id=?',(d.get('payment_status','미결제'),d.get('status','예약 신청'),rid)); c.commit(); c.close(); return send(self,{'ok':True})
        return send(self,{'error':'Not found'},404)

if __name__=='__main__':
    init_db(); port=int(os.environ.get('PORT','8000')); print(f'http://localhost:{port}'); ThreadingHTTPServer(('0.0.0.0',port),Handler).serve_forever()
